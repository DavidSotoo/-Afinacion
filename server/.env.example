# ─────────────────────────────────────────────────────────────────────────────
# PLANTILLA DE VARIABLES DE ENTORNO — server/.env.example
#
# Copia este archivo como "server/.env" y rellena los valores reales.
# NUNCA subas el archivo ".env" real al repositorio — está en .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos ─────────────────────────────────────────────────────────────
# Formato: mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/?appName=<app>
MONGODB_URI="mongodb+srv://TU_USUARIO:TU_CONTRASEÑA@cluster0.xxxxxx.mongodb.net/?appName=NombreApp"
MONGO_URI="mongodb+srv://TU_USUARIO:TU_CONTRASEÑA@cluster0.xxxxxx.mongodb.net/?appName=NombreApp"

# ── Autenticación ─────────────────────────────────────────────────────────────
ADMIN_PIN="TU_PIN_ADMIN_NUMERICO"
JWT_SECRET="string_secreto_largo_y_aleatorio_minimo_32_chars"

# ── Mercado Pago ──────────────────────────────────────────────────────────────
# PRUEBAS (sandbox): Obtén el token en mercadopago.com.mx/developers/panel
#   → Tu app → Credenciales → Credenciales de PRUEBA → Access Token
#   Empieza con: APP_USR- (nueva API) o TEST- (API legacy)
#
# PRODUCCIÓN: cuando el cliente active las credenciales de producción,
#   reemplaza únicamente este valor con el token de producción.
#   → Tu app → Credenciales → Credenciales de PRODUCCIÓN → Access Token
#   NO se requiere ningún otro cambio de código.
MERCADOPAGO_ACCESS_TOKEN="APP_USR-TU-TOKEN-DE-PRUEBA-AQUI"

# ── URLs de entorno ───────────────────────────────────────────────────────────
# DESARROLLO LOCAL:
#   FRONTEND_URL=http://localhost:5173
#   BACKEND_URL=http://localhost:5000
#
# PRODUCCIÓN (Render + Hostinger):
#   FRONTEND_URL=https://masafinacion.com
#   BACKEND_URL=https://afinacion-backend.onrender.com
FRONTEND_URL="https://masafinacion.com"
BACKEND_URL="https://afinacion-backend.onrender.com"
NODE_ENV="production"
