# ── Base de datos ─────────────────────────────────────────────────────────────
# MongoDB Connection URI
MONGODB_URI=your_mongodb_connection_string_here
MONGO_URI=your_mongodb_connection_string_here

# ── Mercado Pago — Control de entorno (Vite frontend) ─────────────────────────
# "development" → usa sandbox_init_point (tarjetas de prueba de MP)
# "production"  → usa init_point (cobro real con tarjetas de clientes)
# CAMBIAR A "production" en Hostinger cuando se active el token de producción.
VITE_NODE_ENV=development
